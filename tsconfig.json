{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "./src-js",
    "outDir": "dist"
  },
  "include": ["./src-js/**/*.ts"],
  "exclude": ["./src-js/__deno__/**/*"]
}
